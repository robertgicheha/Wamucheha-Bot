version: "3.8"

# 4 separate services — not one monolith.
# Keep execution logic separate from strategy logic — this is the single biggest
# thing that prevents catastrophic bugs (a bad signal shouldn't be able to bypass
# risk limits).

services:
  # Service 1: Data Ingestion + Strategy/Signal Engine + Risk/Execution Manager
  # (the trading engine — runs the main loop)
  engine:
    build:
      context: .
      dockerfile: Dockerfile.engine
    container_name: trading-engine
    cpus: "${ENGINE_CPU}"
    mem_limit: "${ENGINE_MEM}"
    restart: unless-stopped
    env_file: .env
    volumes:
      - ./config:/app/config:ro
      - engine-data:/app/data
      - ml-models:/app/ml/saved_models
    environment:
      MT5_RPC_HOST: mt5          # compose service name (systemd deploy uses 127.0.0.1 from .env)
      PYTHONUNBUFFERED: "1"
    networks:
      - trading-net
    depends_on:
      - dashboard
      - mt5
    healthcheck:
      test: ["CMD", "python", "-c", "import requests; requests.get('http://dashboard:8000/health', timeout=5)"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s

  # Service 2: Dashboard / Control API
  dashboard:
    build:
      context: .
      dockerfile: Dockerfile.dashboard
    container_name: trading-dashboard
    cpus: "${DASH_CPU}"
    mem_limit: "${DASH_MEM}"
    restart: unless-stopped
    env_file: .env
    ports:
      - "127.0.0.1:8000:8000"
    volumes:
      - engine-data:/app/data:ro
      - ./config:/app/config:ro
    networks:
      - trading-net

  # Service 3: Long-term Equity Screener (runs weekly on schedule)
  screener:
    build:
      context: .
      dockerfile: Dockerfile.screener
    container_name: trading-screener
    cpus: "${SCREENER_CPU}"
    mem_limit: "${SCREENER_MEM}"
    restart: unless-stopped
    env_file: .env
    volumes:
      - ./config:/app/config:ro
      - screener-data:/app/data
    networks:
      - trading-net

  # Service 4: Heartbeat Watchdog (runs on a SEPARATE machine ideally,
  # but included here for completeness — in production, run this outside
  # the same Docker host as the other services)
  watchdog:
    build:
      context: .
      dockerfile: Dockerfile.engine
    container_name: trading-watchdog
    cpus: "${WATCHDOG_CPU}"
    mem_limit: "${WATCHDOG_MEM}"
    restart: unless-stopped
    env_file: .env
    entrypoint: ["python", "scripts/heartbeat_monitor.py"]
    networks:
      - trading-net

  # Service 5: MetaTrader 5 terminal (Windows app, runs under Wine) + RPyC
  # bridge serving the MetaTrader5 Python module. Logs in automatically from
  # MT5_LOGIN/MT5_PASSWORD/MT5_SERVER and restarts the terminal if it crashes.
  # The engine reaches it via MT5_RPC_HOST (see core/mt5_client.py).
  # Ports are bound to localhost only: 18812 serves the bot (systemd deploy
  # connects to 127.0.0.1), 8080/5901 are the noVNC screen — open it through an
  # SSH tunnel: ssh -L 8080:localhost:8080 -L 5901:localhost:5901 user@vps
  mt5:
    image: lprett/mt5linux:1.1.1
    container_name: trading-mt5
    restart: unless-stopped
    environment:
      MT5_HOST: 0.0.0.0
      MT5_LOGIN: ${MT5_LOGIN}
      MT5_PASSWORD: ${MT5_PASSWORD}
      MT5_SERVER: ${MT5_SERVER}
      VNC_PASSWORD: ${MT5_VNC_PASSWORD:-change_me}
    ports:
      - "127.0.0.1:18812:18812"
      - "127.0.0.1:8080:8080"
      - "127.0.0.1:5901:5901"
    networks:
      - trading-net

volumes:
  engine-data:
    driver: local
  ml-models:
    driver: local
  screener-data:
    driver: local

networks:
  trading-net:
    driver: bridge
