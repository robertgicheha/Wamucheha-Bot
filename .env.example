# === Account ===
STAKE_AMOUNT=10          # capital that is NEVER traded (override config.yaml without editing code)
TRADING_BALANCE=10       # capital the bot may trade; only seeds a fresh state DB (existing balance is kept)
# Set STAKE_AMOUNT=10 to start with $10 stake, or any amount you want.
# This overrides config.yaml -> account.stake_amount at startup.
# The amount StateManager actually seeds trading_balance with on TRUE first run.
# Without it, a fresh state DB starts at $0 and the risk manager blocks every
# trade (dry-run or live) forever — there is no other way it gets funded.
# Keep it equal to TRADING_BALANCE above. Only takes effect when the state DB is
# brand new; an already-funded balance is never overwritten, and this never
# touches STAKE_AMOUNT (which stays protected).
INITIAL_TRADING_BALANCE=10

# === Trading Mode ===
LIVE_TRADING=false          # false = paper trading (no real orders). Set true ONLY when ready for real money.

# === Exchange / Broker (trade-only permissions, NO withdrawal permission) ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
# KRAKEN/COINBASE/BYBIT (uncomment if enabled in config.yaml)
# KRAKEN_API_KEY=your_kraken_api_key_here
# KRAKEN_API_SECRET=your_kraken_api_secret_here
# COINBASE_API_KEY=your_coinbase_api_key_here
# COINBASE_API_SECRET=your_coinbase_api_secret_here
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_PAPER=false           # set false only when you're ready for real money (INDEPENDENT of LIVE_TRADING)
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_PRACTICE=false         # true = OANDA practice/demo account (INDEPENDENT of LIVE_TRADING)

# === MetaTrader 5 ===
MT5_LOGIN=your_mt5_account_number_here
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=your_mt5_broker_server_here
MT5_RPC_HOST=127.0.0.1      # Linux VPS: MT5 runs in the `mt5` docker container; bot talks to it over RPyC. Leave empty on Windows.
MT5_RPC_PORT=18812
# NOTE: MT5_SERVER above is a DEMO server. A live broker server name differs
# (e.g. "IC MarketsSC-MT5"), and so does the account number. Real forex/gold
# capital only funds a live server, so confirm both before going live.

# === MetaMask / treasury wallet (READ-ONLY, funding direction only) ===
# This wallet is the TREASURY: you send USDT from it to each exchange's deposit
# address, and you withdraw profits back to it. The bot has NO on-chain code
# (no web3/ethers dependency) and MUST NOT be given the seed phrase or a
# private key here — a plaintext private key in .env would give the whole
# process unrestricted custody of your funds, which is exactly what
# docs/COMMON_MISTAKES.md#9 and ARCHITECTURE.md warn against. Funding stays a
# manual action you perform in the MetaMask UI.
#
# Only public, non-secret values belong below. They are recorded for the
# funding checklist and deposit-address confirmation; nothing signs anything.
METAMASK_WALLET_ADDRESS=0x...your_treasury_address_here     # your 0x... treasury address (public, safe to store)
#   Leave blank until you have one. The bot trades fine without it: funding is
#   always a manual action you perform, and this only feeds the checklist in
#   scripts/preflight.py.
# Network for each venue's USDT deposit. Fees differ hugely:
#   TRC20 (Tron) ~1 USDT   BEP20 (BNB Smart Chain) ~0.1-1 USDT
#   ERC20 (Ethereum) ~5-20 USDT  <- avoid for bulk transfers
# Match the network EXACTLY. Sending on the wrong network can destroy funds.
METAMASK_NETWORK=TRC20
# Optional: read-only RPC endpoints, used only to display a treasury balance.
# Public defaults need no key; an Infura/Alchemy key removes rate limits.
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key_here
TRON_RPC_URL=https://api.trongrid.io
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Optional: block-explorer API key for verifying a deposit was credited before
# trading on it. Etherscan works for ERC20/BEP20.
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Funding amounts per venue, used by the funding checklist to tell you how much
# USDT to send where. The bot does not move money; you do, in MetaMask.
FUNDING_BINANCE_USDT=0x...binance_deposit_address_here
FUNDING_OKX_USDT=0x...okx_deposit_address_here
FUNDING_BYBIT_USDT=0x...bybit_deposit_address_here
MT5_VNC_PASSWORD=your_vnc_password_here

# === Data providers ===
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
FMP_API_KEY=your_fmp_api_key_here
NEWSAPI_KEY=your_newsapi_key_here
# NOTE: the old RAPID_API_KEY line was a byte-for-byte copy of NEWSAPI_KEY and
# returned HTTP 403 "You are not subscribed to this API" from RapidAPI. Removed.

# --- NSE Kenya (Nairobi Stock Exchange) ---
# RapidAPI key for "Nairobi Stock Exchange (NSE)" — get it from
# https://rapidapi.com -> your account -> API keys -> that API.
# The Basic plan allows 4 requests/hour and 250/month, so the bot makes exactly
# ONE call per trading day at 16:00 Africa/Nairobi. If this is empty, NSE prices
# fall back to the free afx.kwayisi.org source and no quota is spent.
NSE_RAPIDAPI_KEY=your_nse_rapidapi_key_here
# Host is fixed unless you are self-proxying the API. Present so the value is
# visible and editable rather than buried in source.
NSE_RAPIDAPI_HOST=nairobi-stock-exchange-nse.p.rapidapi.com


TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_WEBHOOK_TRADES=     # optional: separate webhook for trade logs (falls back to DISCORD_WEBHOOK_URL)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your_email_here
EMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_TO=your_email_here

# === Interactive Control Bots ===
# Telegram control bot (python-telegram-bot) — DM your bot with /status, /kill, etc.
# Create a bot via @BotFather, paste the token here
# TELEGRAM_BOT_TOKEN=       # same token as above -- used by the interactive control bot too
TELEGRAM_ALLOWED_USERS=     # comma-separated Telegram user IDs (empty = anyone can control)

# Discord control bot (discord.py) — DM or mention with !status, !kill, etc.
# Create a bot at discord.com/developers/applications, paste token here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ALLOWED_ROLES=      # comma-separated role names (empty = anyone can control)

# === ML Backend ===
# LSTM_MODEL_TYPE=pytorch   # "pytorch" or "tensorflow" (also configurable in config.yaml -> ml.lstm_model_type)

# === Dashboard ===
DASHBOARD_SECRET_KEY=your_dashboard_secret_key_here
DASHBOARD_PORT=8000

# === Watchdog (runs on your LOCAL machine, points at the VPS) ===
VPS_HEARTBEAT_URL=http://your_vps_ip:8000/health
# Bare public IP of that VPS — no scheme, no port, no path (api.ipify.org
# format). Exchange API keys are allowlisted to it, so the bot only works from
# the VPS. scripts/preflight.py compares this against the address you are
# actually running from and BLOCKS if they differ, which is the point: it
# catches you testing from a laptop, where every signed request will fail.
EXPECTED_VPS_IP=your_vps_public_ip_here
HEARTBEAT_ALERT_AFTER_MINUTES=1440   # alert if state hasn't updated in this many minutes
HEARTBEAT_POLL_INTERVAL_SEC=60    # how often to poll the VPS health endpoint
HEARTBEAT_CONNECT_TIMEOUT_SEC=15  # HTTP connection timeout per poll

# === WMC Bot Poller (optional) ===
WMC_BOT_TOKEN=              # WMC Telegram bot token for community polling

# === Docker resource limits ===
ENGINE_CPU=1.0
ENGINE_MEM=512m
DASH_CPU=0.5
DASH_MEM=256m
SCREENER_CPU=0.5
SCREENER_MEM=256m
WATCHDOG_CPU=0.25
WATCHDOG_MEM=128m