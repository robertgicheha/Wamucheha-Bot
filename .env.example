# === Account ===
STAKE_AMOUNT=100            # capital that is NEVER traded (override config.yaml without editing code)
# Set STAKE_AMOUNT=10 to start with $10 stake, or any amount you want.
# This overrides config.yaml -> account.stake_amount at startup.

# === Trading Mode ===
LIVE_TRADING=false          # false = paper trading (no real orders). Set true ONLY when ready for real money.

# === Exchange / Broker (trade-only permissions, NO withdrawal permission) ===
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=             # OKX requires a passphrase in addition to key+secret
# KRaken/COINBASE/BYBIT (uncomment if enabled in config.yaml)
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true           # set false only when you're ready for real money
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true         # true = OANDA practice/demo account

# === MetaTrader 5 ===
MT5_LOGIN=                  # MT5 account number
MT5_PASSWORD=               # MT5 password
MT5_SERVER=                 # MT5 broker server (e.g. "MetaQuotes-Demo")

# === Data providers ===
ALPHA_VANTAGE_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
APIFY_TOKEN=                # for NSE Kenya data scraping

# === Alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TRADES=     # optional: separate webhook for trade logs (falls back to DISCORD_WEBHOOK_URL)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_TO=

# === Interactive Control Bots ===
# Telegram control bot (python-telegram-bot) — DM your bot with /status, /kill, etc.
# Create a bot via @BotFather, paste the token here
# TELEGRAM_BOT_TOKEN=       # same token as above -- used by the interactive control bot too
TELEGRAM_ALLOWED_USERS=     # comma-separated Telegram user IDs (empty = anyone can control)

# Discord control bot (discord.py) — DM or mention with !status, !kill, etc.
# Create a bot at discord.com/developers/applications, paste token here
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_ROLES=      # comma-separated role names (empty = anyone can control)

# === ML Backend ===
# LSTM_MODEL_TYPE=pytorch   # "pytorch" or "tensorflow" (also configurable in config.yaml -> ml.lstm_model_type)

# === Dashboard ===
DASHBOARD_SECRET_KEY=change_me_to_something_random
DASHBOARD_PORT=8000

# === Watchdog (runs on your LOCAL machine, points at the VPS) ===
VPS_HEARTBEAT_URL=http://YOUR_VPS_IP:8000/health
HEARTBEAT_ALERT_AFTER_MINUTES=5   # alert if state hasn't updated in this many minutes
HEARTBEAT_POLL_INTERVAL_SEC=60    # how often to poll the VPS health endpoint
HEARTBEAT_CONNECT_TIMEOUT_SEC=15  # HTTP connection timeout per poll

# === WMC Bot Poller (optional) ===
WMC_BOT_TOKEN=              # WMC Telegram bot token for community polling
