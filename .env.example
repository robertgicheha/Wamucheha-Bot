# === Account ===
STAKE_AMOUNT=10          # capital that is NEVER traded (override config.yaml without editing code)
TRADING_BALANCE=10       # capital the bot may trade; only seeds a fresh state DB (existing balance is kept)
# Set STAKE_AMOUNT=10 to start with $10 stake, or any amount you want.
# This overrides config.yaml -> account.stake_amount at startup.
# The amount StateManager actually seeds trading_balance with on TRUE first run.
# Without it, a fresh state DB starts at $0 and the risk manager blocks every
# trade (dry-run or live) forever — there is no other way it gets funded.
# Keep it equal to TRADING_BALANCE above. Only takes effect when the state DB is
# brand new; an already-funded balance is never overwritten, and this never
# touches STAKE_AMOUNT (which stays protected).
INITIAL_TRADING_BALANCE=10

# === Trading Mode ===
LIVE_TRADING=false          # false = paper trading (no real orders). Set true ONLY when ready for real money.

# === Exchange / Broker (trade-only permissions, NO withdrawal permission) ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
# KRAKEN/COINBASE/BYBIT (uncomment if enabled in config.yaml)
# KRAKEN_API_KEY=your_kraken_api_key_here
# KRAKEN_API_SECRET=your_kraken_api_secret_here
# COINBASE_API_KEY=your_coinbase_api_key_here
# COINBASE_API_SECRET=your_coinbase_api_secret_here
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# === MetaTrader 5 ===
MT5_LOGIN=your_mt5_account_number_here
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=your_mt5_broker_server_here
MT5_RPC_HOST=127.0.0.1      # Linux VPS: MT5 runs in the `mt5` docker container; bot talks to it over RPyC. Leave empty on Windows.
MT5_RPC_PORT=18812
# NOTE: MT5_SERVER above is a DEMO server. A live broker server name differs
# (e.g. "IC MarketsSC-MT5"), and so does the account number. Real forex/gold
# capital only funds a live server, so confirm both before going live.

# === Funding: one funder, one settlement, no self-custody wallet ===
# Design: capital is drawn from ONE venue (the funder) and every venue's profit
# is withdrawn back to ONE venue (the settlement). Both are exchanges, so there
# is no wallet, no seed phrase, and nothing for the bot to sign.
#
# The bot has NO on-chain code (no web3/ethers dependency) and MUST NOT be
# given a seed phrase or private key here — a plaintext key in .env would give
# the whole process unrestricted custody, which is exactly what
# docs/COMMON_MISTAKES.md#9 and ARCHITECTURE.md warn against. Every transfer
# below is a manual action you perform in the exchange's own UI.
#
# ── How the money actually moves ──
# Exchange-internal transfers only work between accounts on the SAME exchange,
# so funding a second venue always means an ON-CHAIN withdrawal: OKX -> chain
# -> Binance deposit address. That costs a network fee and takes settlement
# time. Plan rebalances as an explicit, manual step; do not expect instant
# cross-venue movement.
#
# Because settlement is also one venue, every balance the bot can reach depends
# on that one account staying available. Enable withdrawal allowlists and
# withdrawal 2FA on it.
FUNDING_SOURCE_VENUE=okx        # where capital is drawn from
SETTLEMENT_VENUE=okx            # whose deposit address receives profit withdrawals
# Network for every USDT transfer below. Fees differ hugely:
#   TRC20 (Tron)     ~1 USDT       BEP20 (BNB Smart Chain) ~0.1-1 USDT
#   ERC20 (Ethereum) ~5-20 USDT    SOL (Solana)            ~0.01 USDT
# Match the network EXACTLY on BOTH sides. Sending on the wrong network
# destroys the deposit and nobody can recover it.
# NOTE: TRC20 is Tron, whose addresses start with "T", not "0x". A 0x address
# is a BEP20/ERC20 address and will not be credited to a TRC20 deposit.
TRANSFER_NETWORK=TRC20
# Each venue's USDT DEPOSIT ADDRESS — the destination you SEND to when funding
# it. These are addresses, not amounts; the name is historical and kept so
# existing .env files keep working. Copy each one from that exchange's Deposit
# screen, never from an email or a previous chat.
FUNDING_OKX_USDT=Tyour_okx_deposit_address_here
FUNDING_BINANCE_USDT=0xyour_binance_deposit_address_here
FUNDING_BYBIT_USDT=0xyour_bybit_deposit_address_here
# NOTE: MT5 is a FOREX broker, not an exchange. It cannot be funded by a USDT
# transfer from OKX or Binance — use the broker's own deposit methods (card,
# bank wire, or M-Pesa where supported). It is deliberately absent from the
# FUNDING_*_USDT list above so nobody tries.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your_email_here
EMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_TO=your_email_here

# These can halt, resume, restart and forge ledger entries. Both fail CLOSED:
# an empty list denies every command from everyone, and the engine refuses to
# start a control bot that has a token but no allowlist.
#
# Your numeric user ID: message @userinfobot on Telegram. Comma-separate to allow more than one.

# Comma-separated ROLE names, matched case-insensitively against the sender's
# roles. An empty list denies everyone. Grant the role in Discord — do not list
# the role name here without also creating it there, or nobody will match.

# === ML Backend ===
# LSTM_MODEL_TYPE=pytorch   # "pytorch" or "tensorflow" (also configurable in config.yaml -> ml.lstm_model_type)

# === Logging ===
# VERBOSE_LOGGING=true  # Set to true for detailed console output of trades, signals, fees, risk events

# === Dashboard ===
DASHBOARD_SECRET_KEY=your_dashboard_secret_key_here
DASHBOARD_PORT=8000

# === Docker resource limits ===
ENGINE_CPU=1.0
ENGINE_MEM=512m
DASH_CPU=0.5
DASH_MEM=256m
# === FX trend bot admin dashboard (dashboard/fx_admin.py) ===
# REQUIRED, 16+ random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
FX_ADMIN_TOKEN=
FX_ADMIN_PORT=8090
MT5_DEMO_ORDERS=false  # true = send real orders to an MT5 DEMO account (play money). Ignored unless MT5_SERVER contains 'demo'.
