[Unit]
Description=Trading Bot - Long-Term Equity Screener
After=network-online.target

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/trading_bot
EnvironmentFile=/opt/trading_bot/.env
ExecStart=/opt/trading_bot/venv/bin/python /opt/trading_bot/long_term/scheduler.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
